      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "notif_outbox_waiting_events",
          "legendFormat": "outbox waiting"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(notif_deliveries_waiting)",
          "legendFormat": "deliveries not done"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(notif_broker_pending_messages)",
          "legendFormat": "waiting in broker"
        }
      ]
    },
