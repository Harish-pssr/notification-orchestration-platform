# Copy to .env (which is never committed) and fill in. Used by docker compose.

# --- production (docker-compose.prod.yml) ---
DOMAIN=notifications.example.com   # a name whose DNS record points at this machine
ACME_EMAIL=you@example.com         # required: Let's Encrypt contact for certificate notices
POSTGRES_PASSWORD=change-me        # use a long random value: openssl rand -hex 24
ADMIN_TOKEN=change-me              # protects replay (and fault injection if enabled): openssl rand -hex 24

# Fault injection is OFF unless you set this to true. Leave it false on a deployment that
# faces the internet (D8): it exists for demos and experiments.
FAULTS_ENABLED=false

# --- optional ---
# POSTGRES_USER=notif
GRAFANA_PASSWORD=change-me         # only with --profile grafana
# HTTP_PORT=80
# HTTPS_PORT=443
