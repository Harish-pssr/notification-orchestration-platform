# Copy to .env (never committed). Local development needs no .env: the defaults in
# docker-compose.yml work. A production deployment needs the values below.

# --- production (docker-compose.prod.yml) ---
DOMAIN=notifications.example.com   # a name whose DNS record points at this machine
ACME_EMAIL=you@example.com         # required: Let's Encrypt contact for certificate notices
POSTGRES_PASSWORD=change-me        # use a long random value: openssl rand -hex 24
ADMIN_TOKEN=change-me              # the one credential for every write: creating events, replay, faults. openssl rand -hex 24

# Fault injection is OFF unless you set this to true. Leave it false on a deployment that
# faces the internet (D8): it exists for demos and experiments.
FAULTS_ENABLED=false

# --- optional ---
# POSTGRES_USER=notif
GRAFANA_PASSWORD=change-me         # only with --profile grafana
# HTTP_PORT=80
# HTTPS_PORT=443

# --- real email sending (optional, D21) ---
# Leave these out and the email channel stays the mock: nothing is ever sent. With them set, the Duplicates page
# gets a switch for sending REAL emails to one fixed recipient. The switch always starts off, a hard cap limits
# the sends per hour, and the benchmark tools refuse to run while it is on.
# Gmail: turn on 2-Step Verification, create an App password, then use:
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587                # 465 uses implicit TLS
# EMAIL_SMTP_USER=you@gmail.com
# EMAIL_SMTP_PASS=the-16-character-app-password
# EMAIL_FROM=you@gmail.com           # defaults to EMAIL_SMTP_USER
# EMAIL_TO=you@gmail.com             # the recipient until you save another in the dashboard
# EMAIL_MAX_PER_HOUR=20
# A real send takes several seconds, longer than the consumers' default 5 s call timeout. Without this the consumer
# times out and retries, and with the protections off every retry sends another real email.
# CALL_TIMEOUT=30s
